{
  "name": "spicetify-lyrics-overlay",
  "version": "2.2.0",
  "description": "A transparent, language-aware Windows lyrics companion for Spicetify",
  "author": {
    "name": "Nour Al-Shammari (0xTuFa7)",
    "email": "tufa7shaml@gmail.com",
    "url": "https://xtufa7.github.io"
  },
  "homepage": "https://github.com/xtufa7/Lyrics-Overlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/xtufa7/Lyrics-Overlay.git"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "test:desktop": "npm run build && tsx scripts/desktop-smoke.ts",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "install:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-extension.ps1"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.2.6",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.2.8",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  },
  "build": {
    "appId": "org.spicetify.lyricsoverlay",
    "productName": "Spicetify Lyrics Overlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "dist/extension/lyrics-overlay.js",
        "to": "lyrics-overlay.js"
      },
      {
        "from": "scripts/install-extension.ps1",
        "to": "install-extension.ps1"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "Lyrics-Overlay-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Spicetify-Lyrics-Overlay-${version}-Setup.${ext}"
    }
  }
}
